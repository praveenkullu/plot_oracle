         EXTERNAL SYSTEMS
    ══════════════════════════════════════════════════════════════ -->
    <mxCell id="chainlink_feed" value="&lt;b&gt;Chainlink Price Feed&lt;/b&gt;&lt;br/&gt;PLOT/USD&lt;br/&gt;AggregatorV3Interface&lt;br/&gt;(register post-mainnet)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;strokeWidth=2;strokeDash=5;"
      vertex="1" parent="1">
      <mxGeometry x="270" y="1330" width="210" height="80" as="geometry" />
    </mxCell>

    <mxCell id="arweave" value="&lt;b&gt;Arweave&lt;/b&gt;&lt;br/&gt;Permanent claim content storage&lt;br/&gt;contentHash on-chain;&lt;br/&gt;full text off-chain"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="504" y="1330" width="210" height="80" as="geometry" />
    </mxCell>

    <mxCell id="usdc_token" value="&lt;b&gt;USDC (Base L2)&lt;/b&gt;&lt;br/&gt;ERC20 · 6 decimals&lt;br/&gt;Bond &amp; fee currency&lt;br/&gt;used by BondEscrow"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;"
      vertex="1" parent="1">
      <mxGeometry x="738" y="1330" width="210" height="80" as="geometry" />
    </mxCell>

    <mxCell id="gnosis_safe" value="&lt;b&gt;Gnosis Safe (pre-mainnet)&lt;/b&gt;&lt;br/&gt;Admin + Foundation multisigs&lt;br/&gt;DEFAULT_ADMIN_ROLE handoff&lt;br/&gt;from deployer wallet (pending)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;dashed=1;strokeWidth=2;"
      vertex="1" parent="1">
      <mxGeometry x="270" y="1430" width="210" height="80" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════
         EDGES — Claim Submission Flow
    ══════════════════════════════════════════════════════════════ -->

    <!-- User → Backend (submit claim) -->
    <mxCell id="e_user_backend" value="POST /claims&lt;br/&gt;GET /claims"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;"
      edge="1" source="actor_user" target="backend" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Backend → BondCalculator -->
    <mxCell id="e_back_bondcalc" value="calculateBond(&lt;br/&gt;domain, complexityBps)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="backend" target="bond_calc" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Backend → ClaimRegistry -->
    <mxCell id="e_back_registry" value="submitClaim()"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="backend" target="claim_registry" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Backend → SNS -->
    <mxCell id="e_back_sns" value="POST /novelty/check&lt;br/&gt;POST /novelty/embed"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="backend" target="sns" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Backend → NoveltyGate (relay result) -->
    <mxCell id="e_back_noveltygate" value="submitNoveltyResult()&lt;br/&gt;(relay signer)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="backend" target="novelty_gate" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Backend → Ponder (GET /claims proxy) -->
    <mxCell id="e_back_ponder" value="proxy GraphQL&lt;br/&gt;(GET /claims)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="backend" target="ponder" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ClaimRegistry → BondEscrow (lockBond on submitClaim) -->
    <mxCell id="e_registry_escrow" value="lockBond()"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="claim_registry" target="bond_escrow" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- NoveltyGate → ClaimRegistry -->
    <mxCell id="e_novelty_registry" value="setNoveltyResult()&lt;br/&gt;→ Pending | Rejected"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="novelty_gate" target="claim_registry" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Ponder ← ClaimRegistry (events, dashed) -->
    <mxCell id="e_registry_ponder" value="ClaimSubmitted,&lt;br/&gt;StatusChanged events"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;dashed=1;endArrow=open;endFill=0;"
      edge="1" source="claim_registry" target="ponder" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════
         EDGES — Challenge & Resolution Flow
    ══════════════════════════════════════════════════════════════ -->

    <!-- ChallengeWindow → ClaimRegistry (markDisputed / resolveUnchallenged) -->
    <mxCell id="e_challenge_registry" value="markDisputed()&lt;br/&gt;resolveUnchallenged()"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="challenge_window" target="claim_registry" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ChallengeWindow → OracleRouter (on dispute) -->
    <mxCell id="e_challenge_router" value="on challenge filed"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="challenge_window" target="oracle_router" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- OracleRouter → InternalVote -->
    <mxCell id="e_router_vote" value="triggerVote(claimId)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="oracle_router" target="internal_vote" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- InternalVote → ConfidenceScorer -->
    <mxCell id="e_vote_scorer" value="score(rawScore, domain)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="internal_vote" target="conf_scorer" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- InternalVote → OracleRouter (executeResolution) -->
    <mxCell id="e_vote_router" value="executeResolution(&lt;br/&gt;verified, score)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="internal_vote" target="oracle_router" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="609" y="1100" />
          <mxPoint x="375" y="1100" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- OracleRouter → BondEscrow (release/slash) -->
    <mxCell id="e_router_escrow" value="release / slash USDC"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="oracle_router" target="bond_escrow" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- OracleRouter → ClaimRegistry (update status) -->
    <mxCell id="e_router_registry" value="resolveVerified()&lt;br/&gt;resolveRejected()"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="oracle_router" target="claim_registry" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Keeper → ChallengeWindow -->
    <mxCell id="e_keeper_challenge" value="finalizeUnchallenged(claimId)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="actor_keeper" target="challenge_window" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Keeper → OracleRouter (releaseSubmitterBond) -->
    <mxCell id="e_keeper_router" value="releaseSubmitterBond(claimId)&lt;br/&gt;recordSnapshot24h/7d()&lt;br/&gt;checkCircuitBreaker()"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="actor_keeper" target="oracle_router" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Ponder ← ChallengeWindow events -->
    <mxCell id="e_challenge_ponder" value="WindowOpened,&lt;br/&gt;ChallengeFiled events"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;dashed=1;endArrow=open;endFill=0;"
      edge="1" source="challenge_window" target="ponder" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════════
         EDGES — Token, Emissions & Governance
    ══════════════════════════════════════════════════════════════ -->

    <!-- EmissionController → PLOTToken -->
    <mxCell id="e_emission_plot" value="mintEmission(rewardsPool)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="emission_ctrl" target="plot_token" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- PLOTToken → GovernorPlot (voting power) -->
    <mxCell id="e_plot_governor" value="voting power (ERC20Votes)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="plot_token" target="governor" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- GovernorPlot → TimelockController -->
    <mxCell id="e_governor_timelock" value="queue proposals"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="governor" target="timelock" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- TimelockController → BondCalculator (governance execution) -->
    <mxCell id="e_timelock_bondcalc" value="execute (setDomainBaseBond)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="timelock" target="bond_calc" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="843" y="1460" />
          <mxPoint x="375" y="1460" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- TimelockController → Treasury -->
    <mxCell id="e_timelock_treasury" value="execute (withdraw, buyback)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="timelock" target="treasury" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- BondEscrow → Treasury (20% slash fees) -->
    <mxCell id="e_escrow_treasury" value="slash fees (20%)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="bond_escrow" target="treasury" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- EmissionController → Chainlink -->
    <mxCell id="e_emission_chainlink" value="getPriceFeed()&lt;br/&gt;latestRoundData()"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="emission_ctrl" target="chainlink_feed" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- BondEscrow → USDC -->
    <mxCell id="e_escrow_usdc" value="transferFrom / transfer"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;"
      edge="1" source="bond_escrow" target="usdc_token" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Gnosis Safe → Treasury (admin handoff, dashed) -->
    <mxCell id="e_safe_treasury" value="DEFAULT_ADMIN_ROLE handoff&lt;br/&gt;(pre-mainnet)"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;dashed=1;"
      edge="1" source="gnosis_safe" target="treasury" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Ponder ← InternalVote events -->
    <mxCell id="e_vote_ponder" value="VoteCast, VoteFinalized"
      style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=9;html=1;dashed=1;endArrow=open;endFill=0;"
      edge="1" source="internal_vote" target="ponder" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
